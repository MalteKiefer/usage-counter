{
  "name": "usage-counter",
  "version": "1.0.0",
  "description": "Heizöl, Wasser und Strom erfassen, auswerten und Reichweite prognostizieren. Mehrere Objekte, Zähler mit Untermessern, Tankstand-Schätzung.",
  "license": "MIT",
  "author": "Malte Kiefer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MalteKiefer/usage-counter.git"
  },
  "bugs": {
    "url": "https://github.com/MalteKiefer/usage-counter/issues"
  },
  "homepage": "https://github.com/MalteKiefer/usage-counter#readme",
  "keywords": [
    "heating-oil",
    "water-meter",
    "power-meter",
    "usage-tracking",
    "self-hosted",
    "react",
    "sqlite"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test src/lib/derive.test.js src/lib/tank.test.js src/lib/water.test.js src/lib/format.test.js server/api.test.js server/db.test.js server/backup.test.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "vite": "^8.3.6"
  }
}
