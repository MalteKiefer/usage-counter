# Copy to .env next to docker-compose.yml. Compose reads it for ${VAR} substitution.
# Never commit .env or files in secrets/.

# Image version to run
USAGE_COUNTER_VERSION=2.1.0

# Extra host names allowed in the Host header, comma separated (for LAN access)
ALLOWED_HOSTS=

# Largest backup that can be exported or restored, in MB (1 to 100)
BACKUP_LIMIT_MB=25

# Sign-in with Pocket-ID (OIDC). Set OIDC_ENABLED=true and fill in all OIDC_ values.
# The client secret goes into secrets/oidc_client_secret, see README.
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URL=
# Comma separated list of mail addresses that may sign in
OIDC_ALLOWED_EMAILS=
# Days a sign-in stays valid (1 to 30)
SESSION_DAYS=7
